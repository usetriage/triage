{
  "name": "usetriage",
  "version": "0.8.1",
  "type": "module",
  "description": "Ranked work inbox for engineers — every item arrives with its action drafted, dispatch straight into your local Claude Code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetriage/triage.git"
  },
  "homepage": "https://usetriage.sh",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "triage": "dist/server/cli.js",
    "triage-mcp": "dist/server/mcp.js"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "clear-port": "./clear-port.sh",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "dev:server": "tsx server/index.ts",
    "mcp": "tsx server/mcp.ts",
    "dev:web": "vite",
    "build": "rm -rf dist && vite build && tsc -p tsconfig.publish.json",
    "start": "tsx server/index.ts",
    "prepublishOnly": "npm run typecheck && npm run build",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.268",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.14",
    "lucide-react": "^1.37.0",
    "marked": "^18.0.11",
    "mermaid": "^12.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
